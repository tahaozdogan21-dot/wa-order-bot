# Claude API anahtarı (console.anthropic.com üzerinden alınır)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Bildirimlerin gideceği WhatsApp numarası (ülke kodu ile, başında + yok, boşluksuz)
# Örnek: Türkiye için 90 ile başlar -> 905xxxxxxxxx
OWNER_WHATSAPP_NUMBER=905xxxxxxxxx

# Render web service portu (Render otomatik PORT env'i verir, lokal için varsayılan)
PORT=3000
